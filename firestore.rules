rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: userId
    // Fields:
    //   - id: string (required)
    //   - email: string (required)
    //   - name: string (required)
    //   - photoURL: string (optional)
    //   - currency: string (required)
    //   - location: string (optional)
    //   - occupation: string (optional)
    //   - hasCompletedSetup: boolean (required)
    //   - settings: map (optional)
    //
    // Collection: financialProfiles
    // Document ID: userId
    // Fields:
    //   - userId: string (required)
    //   - monthlySalary: number (required)
    //   - currentSavings: number (required)
    //   - expenses: list (required)
    //   - updatedAt: number (required)
    //
    // Collection: savedScenarios
    // Document ID: scenarioId
    // Fields:
    //   - id: string (required)
    //   - userId: string (required)
    //   - name: string (required)
    //   - salary: number (required)
    //   - savings: number (required)
    //   - expenses: list (required)
    //   - scenarioType: string (required)
    //   - timestamp: number (required)
    //
    // Collection: debts
    // Document ID: debtId
    // Fields:
    //   - id: string (required)
    //   - userId: string (required)
    //   - title: string (required)
    //   - issuer: string (optional)
    //   - amount: number (required)
    //   - dueDate: string (optional)
    //   - category: string (optional)
    //   - priority: string (optional)
    //   - riskLevel: string (optional)
    //   - status: string (required)
    //   - createdAt: number (required)
    //   - completedAt: number (optional)
    //   - proofOfPayment: string (optional)
    //   - analysisId: string (optional)
    //   - notes: string (optional)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.userId;
    }

    function isRequestOwner() {
      return isAuthenticated() && request.auth.uid == request.resource.data.userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin' ||
          (request.auth.token.get('email', '') == "akshitashah2106@gmail.com" && 
           request.auth.token.get('email_verified', false) == true));
    }

    function uidUnchanged() {
      return !('userId' in request.resource.data) ||
        request.resource.data.userId == request.auth.uid;
    }

    function uidNotModified() {
      return !('userId' in request.resource.data) ||
        request.resource.data.userId == resource.data.userId;
    }

    function hasOnlyAllowedFields(allowedFields) {
      return request.resource.data.keys().hasOnly(allowedFields);
    }

    function hasRequiredFields(requiredFields) {
      return request.resource.data.keys().hasAll(requiredFields);
    }

    function validString(field, maxLen) {
      return request.resource.data[field] is string && request.resource.data[field].size() <= maxLen;
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidUser(data) {
      return data.id is string &&
             data.email is string &&
             data.name is string &&
             data.currency is string &&
             data.hasCompletedSetup is bool &&
             data.name.size() > 0 && data.name.size() <= 100 &&
             data.email.size() <= 150 &&
             (!('location' in data) || (data.location is string && data.location.size() <= 100)) &&
             (!('occupation' in data) || (data.occupation is string && data.occupation.size() <= 100)) &&
             (!('role' in data) || (data.role is string && data.role.size() <= 20));
    }

    function isValidFinancialProfile(data) {
      return data.userId is string &&
             data.monthlySalary is number &&
             data.currentSavings is number &&
             data.expenses is list &&
             data.updatedAt is number &&
             data.expenses.size() <= 50;
    }

    function isValidSavedScenario(data) {
      return data.id is string &&
             data.userId is string &&
             data.name is string &&
             data.salary is number &&
             data.savings is number &&
             data.expenses is list &&
             data.scenarioType is string &&
             data.timestamp is number &&
             data.name.size() <= 100 &&
             data.expenses.size() <= 50;
    }

    function isValidDebtTask(data) {
      return data.userId is string &&
             data.title is string &&
             data.amount is number &&
             data.status is string &&
             data.createdAt is number &&
             data.title.size() > 0 && data.title.size() <= 150 &&
             (!('issuer' in data) || (data.issuer is string && data.issuer.size() <= 100)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000));
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUser(request.resource.data) && 
                      (request.resource.data.get('role', 'user') == 'user');
      allow update: if isOwner(userId) && isValidUser(request.resource.data) && 
                      (request.resource.data.get('role', 'user') == resource.data.get('role', 'user') || isAdmin());
      allow delete: if isAdmin();
    }

    match /financialProfiles/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidFinancialProfile(request.resource.data);
      allow update: if isOwner(userId) && isValidFinancialProfile(request.resource.data);
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /savedScenarios/{scenarioId} {
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && isValidSavedScenario(request.resource.data);
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid && isValidSavedScenario(request.resource.data);
      allow delete: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    match /debts/{debtId} {
      allow read: if (isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid)) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && isValidDebtTask(request.resource.data);
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid && isValidDebtTask(request.resource.data);
      allow delete: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // Default deny
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
